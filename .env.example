# Copy to .env.local for local development. Placeholders only — never commit real values.

# Public origin used for canonical URLs, sitemap, and Open Graph tags.
# Production: https://maverickinnogarage.com   Preview: leave unset on Vercel (VERCEL_URL is used).
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery. If delivery isn't configured, the form asks visitors to call instead,
# and the API returns 503. It never pretends to send.
# Inbox that receives inquiries:
CONTACT_TO_EMAIL=inquiries@example.com
# Sender: a mailbox the SMTP account is allowed to send as (or a Resend-verified domain).
CONTACT_FROM_EMAIL="Maverick InnoGarage Website <website@example.com>"

# Option A: company mailbox over SMTP (used whenever SMTP_HOST is set).
#   Microsoft 365: smtp.office365.com, port 587 (SMTP AUTH must be enabled for the mailbox)
#   Google Workspace: smtp.gmail.com, port 465 (use an app password)
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (default), 465 = implicit TLS
SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER=website@example.com
SMTP_PASSWORD=replace-with-the-mailbox-or-app-password

# Option B: Resend (https://resend.com). Used only when SMTP_HOST is not set.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret for enabling Draft Mode previews of unpublished insights: /api/draft?secret=...&slug=...
PREVIEW_SECRET=replace-with-a-long-random-string

# Testing only: send contact deliveries to a mock provider instead of Resend (used by Playwright).
# RESEND_API_URL=http://127.0.0.1:4010/emails
