# Copy to .env.local for local development. Placeholders only — never commit real values.

# Public origin used for canonical URLs, sitemap, and Open Graph tags.
# Production: https://maverickinnogarage.com   Preview: leave unset on Vercel (VERCEL_URL is used).
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery (Resend — https://resend.com). If any of these is missing,
# the form shows a "not configured" notice and the API returns 503 instead of pretending to send.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives inquiries. Must be confirmed by Maverick InnoGarage — no address is published on the current site.
CONTACT_TO_EMAIL=inquiries@example.com
# Sender on a domain verified in Resend, e.g. "Maverick InnoGarage Website <web@your-verified-domain>".
CONTACT_FROM_EMAIL="Website <web@example.com>"

# Secret for enabling Draft Mode previews of unpublished insights: /api/draft?secret=...&slug=...
PREVIEW_SECRET=replace-with-a-long-random-string

# Testing only: send contact deliveries to a mock provider instead of Resend (used by Playwright).
# RESEND_API_URL=http://127.0.0.1:4010/emails
